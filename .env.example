# Copy to .env (local) or .env.production (deploy). Server-side secrets go in
# `wrangler secret put` instead: see the list in wrangler.jsonc.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Paddle client-side token: test_... for sandbox, live_... for live
VITE_PAYMENTS_CLIENT_TOKEN=
# "1" enables live checkout once the Paddle account is approved
VITE_LIVE_CHECKOUT_ENABLED=
